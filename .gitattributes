#include <iostream>
#include <cmath>
#include <locale.h> // Türkçe karakter desteği için

using namespace std;

#define PI 3.14159

int main() {
    setlocale(LC_ALL, "Turkish"); // Türkçe karakter desteği
    
    char tekrar;

    do {
        double r;
        cout << "Cemberin yaricapini giriniz: ";
        cin >> r;

        cout << "Cemberin cevresi icin 'c'" << endl;
        cout << "Cemberin alani icin 'a'" << endl;
        
        char secim; 
        while (true) {
            cout << "Seciminizi yapiniz (c/a): ";
            cin >> secim;
            
            if (secim == 'c' || secim == 'C') {
                double cevre = 2 * PI * r;
                cout << "Cemberin cevresi: " << cevre << endl;
                break;
            } else if (secim == 'a' || secim == 'A') {
                double alan = PI * pow(r, 2);
                cout << "Cemberin alani: " << alan << endl;
                break;
            } else {
                cout << "Gecersiz secim. Lutfen tekrar deneyiniz." << endl;
            }
        }

        // Kullanıcıya yeniden başlamak isteyip istemediği soruluyor
        cout << "\nYeniden baslamak istiyor musunuz? (E/H): ";


    } while (tekrar == 'E' || tekrar == 'e'); // E veya e girildiği sürece başa döner

    cout << "\nProgram tamamlandi. Cikmak icin Enter tusuna basiniz..." << endl;
    
    cin.ignore(10000, '\n'); // Tamponu temizler
    cin.get(); // Tuşa basılmasını bekler

    return 0;
}
